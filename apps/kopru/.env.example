# Köprü sunucusu ayarları (kopyalayıp .env olarak kaydedin veya ortam değişkeni verin)

# HTTP/WebSocket portu
PORT=4000

# Unreal Engine Remote Control API
# gercek     → UE'ye HTTP istekleri gönderilir
# simulasyon → UE olmadan çalışır, çağrılar günlüğe yazılır (geliştirme/eğitim için)
UNREAL_MOD=simulasyon
UNREAL_ADRES=http://192.168.10.10:30010
UNREAL_PRESET=DuvarSimulasyonu

# DMX / Art-Net ortam ışığı
ARTNET_AKTIF=0
ARTNET_HEDEF=2.255.255.255
ARTNET_PORT=6454
ARTNET_EVREN=0

# Ön ayar ve senaryo dosyalarının klasörü
# VERI_KLASORU=C:\DuvarSimulasyonu\veri
