# Köprü sunucusu ayarları.
# Bu dosyayı apps/kopru/.env olarak kopyalayın; sunucu açılışta otomatik okur.
# Gerçek ortam değişkeni verilmişse .env'deki değeri ezer.

# HTTP/WebSocket portu
PORT=4000

# Unreal Engine Remote Control API
# gercek     → UE'ye HTTP istekleri gönderilir
# simulasyon → UE olmadan çalışır, çağrılar günlüğe ve panele yazılır (geliştirme/eğitim için)
UNREAL_MOD=simulasyon
UNREAL_ADRES=http://192.168.10.10:30010
UNREAL_PRESET=DuvarSimulasyonu

# DMX / Art-Net ortam ışığı
ARTNET_AKTIF=0
ARTNET_HEDEF=2.255.255.255
ARTNET_PORT=6454
ARTNET_EVREN=0

# Ön ayar ve senaryo dosyalarının klasörü
# VERI_KLASORU=C:\DuvarSimulasyonu\veri

# Örnek paket (paketlenmiş UE oyunu, ör. TCCC kopyası) – panelden "Örneği başlat" düğmesi.
# Boş bırakılırsa panelde bölüm görünmez. Orijinal örnek klasörü değil, kopyasını verin.
# ORNEK_PAKET=C:\Users\<ad>\Desktop\Projeler\ornek-tccc-kopya
ORNEK_PROJE=TCCC
# Doğrudan açılacak harita (boş → ana menü): /Game/Maps/CitySuburbs  /Game/Maps/Mountain_5  /Game/Maps/Orman
ORNEK_HARITA=
# 3 ekran yan yana: 5760x1080; tek ekran deneme: 1920x1080
ORNEK_GENISLIK=1920
ORNEK_YUKSEKLIK=1080
# 1 → NVIDIA Surround/Eyefinity ile tek geniş ekran varken tam ekran; 0 → çerçevesiz pencere (0,0)
ORNEK_TAM_EKRAN=0
# Ek parametreler, ör. düşük kalite: -ExecCmds="sg.GlobalIlluminationQuality 1,sg.ShadowQuality 1,r.ScreenPercentage 75"
ORNEK_EK_PARAMETRELER=

# --- Duvar Oynatıcı içeriği ---
# Panorama, klip ve ses dosyalarının klasörü. Boşsa apps/duvar-oynatici/public/icerik kullanılır.
# Sahada içerik ayrı diskteyse: ICERIK_KLASORU=D:\icerik  (içinde manifest.json olmalı)
ICERIK_KLASORU=
